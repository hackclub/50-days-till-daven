# Airtable personal access token. Give it only the data.records:read scope, and access to only
# the "YSWS - Haven" base. Never commit it; .env* files are gitignored.
AIRTABLE_TOKEN=
# The "YSWS - Haven" base id (starts with "app").
AIRTABLE_BASE_ID=
# Long random string; Vercel Cron sends it to /api/pull. e.g. openssl rand -hex 32
CRON_SECRET=
